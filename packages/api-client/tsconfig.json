{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true,
    // DOM for fetch, URL, AbortController — the web-standard APIs this package
    // uses. Deliberately NOT @types/node: it must run unchanged in React
    // Native and in a browser, so it may only depend on what both provide.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
