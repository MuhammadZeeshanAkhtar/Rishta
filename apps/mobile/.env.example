# =============================================================================
# NikahMate — MOBILE CLIENT environment (apps/mobile)
#
# ⚠️ EVERYTHING IN THIS FILE IS PUBLIC.
#
# Expo inlines every EXPO_PUBLIC_* value into the JavaScript bundle. Anyone who
# downloads the APK can read them in minutes. Only put values here that are
# safe to hand to the public.
#
# NEVER put in this file: a Supabase service-role key, a database URL, a JWT
# secret, or any AI provider key. Those belong in services/.env and are
# rejected at boot if they appear anywhere near the client.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# =============================================================================

# Your NikahMate DEV project URL. Format: https://<project-ref>.supabase.co
# Dashboard: Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# The publishable (anon) key. Safe to ship: it grants nothing on its own,
# because every table is protected by row-level security.
# Dashboard: Project Settings → API Keys → publishable / anon key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the NikahMate API service is reachable.
# Local development: http://localhost:3000
# Android emulator reaching your host machine: http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional. Sentry DSN for the mobile app. A DSN is not a secret — it only
# permits sending events — but leave it blank until you want client reporting.
EXPO_PUBLIC_SENTRY_DSN=
