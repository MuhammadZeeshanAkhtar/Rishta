{
  "expo": {
    "name": "NikahMate",
    "slug": "nikahmate",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nikahmate",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.nikahmate.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#03291F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.nikahmate.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#03291F"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#FAFAF7",
    "primaryColor": "#047857"
  }
}
