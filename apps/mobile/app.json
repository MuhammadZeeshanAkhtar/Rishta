{
  "expo": {
    "name": "NikahMate",
    "slug": "nikahmate",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nikahmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.nikahmate.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A5449"
      }
    },
    "ios": {
      "bundleIdentifier": "com.nikahmate.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A5449"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#0E6B5C"
  }
}
