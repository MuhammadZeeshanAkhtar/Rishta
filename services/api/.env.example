# =============================================================================
# NikahMate — API SERVICE environment (services/api)
#
# ⚠️ EVERYTHING IN THIS FILE IS A SERVER-ONLY SECRET.
#
# This file must never reach a phone, a browser, or a public repository.
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Deliberately ABSENT, and rejected at boot if present (see src/config.ts):
#   SUPABASE_SERVICE_ROLE_KEY — this service reaches Postgres directly over
#     DATABASE_URL, so the service-role key is not needed. Fewer secrets held
#     means fewer secrets that can leak.
#   GEMINI_API_KEY / GOOGLE_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY —
#     v1 uses no AI provider at all (ADR 0006). The process refuses to start
#     if one is set.
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database — THE most sensitive value here.
#
# Full Postgres connection string for your NikahMate DEV project. Must connect
# as a role that can `SET ROLE authenticated`, which the Supabase-provided user
# can. Prefer the pooled (Supavisor, transaction mode) connection string.
#
# Dashboard: Project Settings → Database → Connection string → URI
# Format: postgresql://postgres.<ref>:<password>@<host>:6543/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth — used to verify the JWTs the mobile app sends.
# -----------------------------------------------------------------------------

# Same project URL as the client uses. Not a secret, but needed here to derive
# the token issuer and the JWKS endpoint.
SUPABASE_URL=

# Legacy HS256 signing secret. Fill this in ONLY if your project still uses a
# shared JWT secret. Projects on asymmetric signing keys leave it blank and are
# verified through JWKS instead.
# Dashboard: Project Settings → JWT Keys
SUPABASE_JWT_SECRET=

# Override only if your JWKS endpoint is non-standard. Left blank, it is
# derived as <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Optional. Blank in development is fine and the service starts without it.
SENTRY_DSN=

# Requests per minute per caller before rate limiting engages.
RATE_LIMIT_PER_MINUTE=120
