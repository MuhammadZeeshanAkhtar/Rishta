# =============================================================================
# NikahMate — API SERVICE environment (services/api)
#
# ⚠️ EVERYTHING IN THIS FILE IS A SERVER-ONLY SECRET.
#
# This file must never reach a phone, a browser, or a public repository.
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Deliberately ABSENT, and rejected at boot if present (see src/config.ts):
#   SUPABASE_SERVICE_ROLE_KEY — this service reaches Postgres directly over
#     DATABASE_URL, so the service-role key is not needed. Fewer secrets held
#     means fewer secrets that can leak.
#   GEMINI_API_KEY / GOOGLE_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY —
#     v1 uses no AI provider at all (ADR 0006). The process refuses to start
#     if one is set.
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database — THE most sensitive value here.
#
# Full Postgres connection string for your NikahMate DEV project. Must connect
# as a role that can `SET ROLE authenticated`, which the Supabase-provided user
# can.
#
# USE THE SESSION POOLER, PORT 5432 — not the transaction pooler on 6543.
# Schema changes need a connection that outlives a single transaction, so the
# migration runner REFUSES to start against 6543 rather than failing halfway
# through. Session mode serves the API service perfectly well, so one value
# covers both in development.
#
# Dashboard: Project Settings → Database → Connection string → Session pooler
# Format: postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# docs/SUPABASE_SETUP.md compares all three connection strings and says which
# is for what.
# -----------------------------------------------------------------------------
DATABASE_URL=

# How the database connection is secured. Leave both blank for local Postgres.
#
# For any other host the certificate is verified, and Supabase signs its
# certificates with its own CA. Download it from
#   Project Settings -> Database -> SSL Configuration
# and put either the file's path or its PEM text here:
DATABASE_SSL_CA=
#
# verify-full (default), require (encrypted, certificate unchecked: development
# only, refused when NODE_ENV=production), or disable.
DATABASE_SSL_MODE=

# Which proxies may say who the client is, through X-Forwarded-For. Blank trusts every
# proxy, which is what a deployment behind a load balancer needs. Set it for production:
# the number of proxies in front of the API (usually 1), their addresses, or false.
TRUST_PROXY=

# -----------------------------------------------------------------------------
# Auth — used to verify the JWTs the mobile app sends.
# -----------------------------------------------------------------------------

# Same project URL as the client uses. Not a secret, but needed here to derive
# the token issuer and the JWKS endpoint.
SUPABASE_URL=

# Legacy HS256 signing secret. Fill this in ONLY if your project still uses a
# shared JWT secret. Projects on asymmetric signing keys leave it blank and are
# verified through JWKS instead.
# Dashboard: Project Settings → JWT Keys
SUPABASE_JWT_SECRET=

# Override only if your JWKS endpoint is non-standard. Left blank, it is
# derived as <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# The project's PUBLISHABLE (anon) key, sent as the `apikey` header on Storage
# calls. PUBLIC by design - it identifies the project and grants nothing on its
# own, which is why the identical value ships inside the mobile app. Storage
# authorises on the forwarded member JWT and its RLS policies, never on this.
#
# This is NOT the service-role key. That key is refused at boot.
#
# Required only for photo upload and download; the rest of the API runs without
# it. Dashboard: Project Settings -> API Keys -> publishable / anon key
SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Optional. Blank in development is fine and the service starts without it.
SENTRY_DSN=

# Requests per minute per MEMBER before rate limiting engages (per IP for
# unauthenticated callers). Keyed on the verified token subject, so members
# behind one carrier NAT no longer share a bucket (code review B9).
RATE_LIMIT_PER_MINUTE=120

# The tighter per-member ceiling on routes that send something to another
# person: messages, interests, reports and family invitations (code review B9).
RATE_LIMIT_SENDS_PER_MINUTE=30

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of browser origins permitted to call this API, for the
# future website (README section 19). Leave BLANK for mobile-only use: a native
# app sends no Origin header and is unaffected, so nothing is permitted that was
# not named here.
#
# Development additionally allows localhost on any port, so the Expo web preview
# works with this blank.
#
# Example: CORS_ALLOWED_ORIGINS=https://nikahmate.com,https://www.nikahmate.com
CORS_ALLOWED_ORIGINS=
