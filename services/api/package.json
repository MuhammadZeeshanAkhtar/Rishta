{
  "name": "@nikahmate/api",
  "version": "0.1.0",
  "private": true,
  "description": "Trusted server layer: authorization, business rules, entitlements.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start:prod": "node --env-file-if-exists=.env dist/index.mjs",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:status": "tsx --env-file-if-exists=.env scripts/migrate.ts --status",
    "maintenance": "tsx --env-file-if-exists=.env scripts/maintenance.ts",
    "legacy-content": "tsx --env-file-if-exists=.env scripts/legacy-content.ts",
    "verify:db": "tsx --env-file-if-exists=.env scripts/verify-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nikahmate/domain": "workspace:*",
    "@sentry/node": "^10.19.0",
    "fastify": "^5.12.6",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nikahmate/api-client": "workspace:*",
    "@nikahmate/db": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "vitest": "^4.1.12",
    "tsx": "^4.20.6",
    "esbuild": "0.28.2"
  }
}
